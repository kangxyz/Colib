module

public import Colib.Topology.Realization.FiniteSimplexFamily
public import Colib.Topology.Homotopy.HomotopyGroup.SphericalSimplex

/-! # The actual finite marked family of a spherical simplex

Extracted from `Quillen/Topology/Realization/RelativeSphericalStraightening.lean`
at `c561118b7795eb9780be9ed391c3251d6a4d0afd`, directly on native singular
simplex coordinates. Only the marked finite family and its exact membership
facts are needed, not higher skeleton straightening or chosen sphere models.
-/
@[expose] public noncomputable section
open Topology
universe u
namespace stdSimplex
variable {Z : Type u} [TopologicalSpace Z]

/-- The finite face-closed fixed family generated by one spherical simplex
and the constant top simplex. -/
def sphericalStraighteningFixedFamily {n : ℕ} {z : Z} (f₀ : SphericalSimplex Z z n) :
    FiniteSimplexFamily Z :=
  (finiteVertexRestrictionClosure {f₀.val}).union
    (finiteVertexRestrictionClosure {ContinuousMap.const (_root_.stdSimplex ℝ (Fin (n + 2))) z})

/-- All chosen fixed maps are face closed, with actual equal faces identified. -/
theorem sphericalStraighteningFixedFamily_faceClosed {n : ℕ} {z : Z}
    (f₀ : SphericalSimplex Z z n) : (sphericalStraighteningFixedFamily f₀).FaceClosed :=
  FiniteSimplexFamily.faceClosed_union (finiteVertexRestrictionClosure_faceClosed _)
    (finiteVertexRestrictionClosure_faceClosed _)

/-- The selected spherical input itself belongs to the stationary fixed family. -/
theorem mem_sphericalStraighteningFixedFamily_input {n : ℕ} {z : Z}
    (f₀ : SphericalSimplex Z z n) : f₀.val ∈ sphericalStraighteningFixedFamily f₀ n := by
  classical
  exact Finset.mem_union.mpr
    (Or.inl (mem_finiteVertexRestrictionClosure_self _ (Finset.mem_singleton_self _)))

/-- All constant simplices through the top dimension are explicitly fixed. -/
theorem mem_sphericalStraighteningFixedFamily_const {n d : ℕ} {z : Z}
    (f₀ : SphericalSimplex Z z n) (hd : d ≤ n + 1) :
    ContinuousMap.const (_root_.stdSimplex ℝ (Fin (d + 1))) z ∈
      sphericalStraighteningFixedFamily f₀ d := by
  classical
  apply Finset.mem_union.mpr
  apply Or.inr
  rw [mem_finiteVertexRestrictionClosure]
  exact ⟨hd, _, Finset.mem_singleton_self _, fun _ ↦ 0, rfl⟩

end stdSimplex
