module

public import Colib.LinearAlgebra.TensorAlgebra.HomogeneousLift
public import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# Testing ideal annihilation on pure tensor factors

A linear map from a tensor algebra annihilates the two-sided ideal generated by a set if it
annihilates each generator multiplied on either side by arbitrary pure tensors. The proof uses
the native tensor-algebra direct sum and the existing additive-closure description of a
two-sided ideal span. It does not replace that ideal by a new presentation.

This is the generic ideal-annihilation criterion needed for homogeneous Milnor symbol descent.
-/

@[expose] public noncomputable section

open scoped Pointwise

namespace TensorAlgebra

variable {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N]

/-- It suffices to test a linear map on generators with pure tensor factors on both sides. -/
theorem map_eq_zero_of_mem_span_of_tprod (f : TensorAlgebra R M →ₗ[R] N)
    (S : Set (TensorAlgebra R M))
    (h : ∀ (i j : ℕ) (a : Fin i → M) (b : Fin j → M) (s : TensorAlgebra R M), s ∈ S →
      f (tprod R M i a * s * tprod R M j b) = 0)
    {z : TensorAlgebra R M} (hz : z ∈ TwoSidedIdeal.span S) : f z = 0 := by
  have hright (i : ℕ) (a : Fin i → M) (s : TensorAlgebra R M) (hs : s ∈ S) :
      f.comp (LinearMap.mulLeft R (tprod R M i a * s)) = 0 := by
    apply linearMap_ext_tprod
    intro j b
    exact h i j a b s hs
  have hsand (a b s : TensorAlgebra R M) (hs : s ∈ S) : f (a * s * b) = 0 := by
    have hleft : f.comp (LinearMap.mulRight R (s * b)) = 0 := by
      apply linearMap_ext_tprod
      intro i x
      have hx := LinearMap.congr_fun (hright i x s hs) b
      change f (tprod R M i x * s * b) = 0 at hx
      change f (tprod R M i x * (s * b)) = 0
      rwa [← mul_assoc]
    have ha := LinearMap.congr_fun hleft a
    change f (a * (s * b)) = 0 at ha
    rwa [← mul_assoc] at ha
  rw [TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hz
  have hle : AddSubgroup.closure (Set.univ * S * Set.univ) ≤ f.toAddMonoidHom.ker := by
    apply (AddSubgroup.closure_le _).mpr
    rintro _ ⟨_, ⟨a, _, s, hs, rfl⟩, b, _, rfl⟩
    exact hsand a b s hs
  exact hle hz

end TensorAlgebra
