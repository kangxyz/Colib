module

public import Colib.GroupTheory.Steinberg.KernelGeneration
public import Colib.RingTheory.KTheory.MilnorK.Steinberg

/-!
# Surjectivity of the native Milnor-to-Steinberg-kernel map

The actual stable kernel is generated by its ordered torus defects. Native
Stacks tuple-symbol generation identifies exactly the range of the already
constructed canonical Milnor map. Thus that same map is surjective over every
field, including characteristics two and three. No new comparison map is defined.

## Implementation provenance

The Milnor range reduction and final consequence of
`Quillen/Algebra/Group/StableSteinbergRankTwo.lean` and
`Quillen/Algebra/Group/StableSteinbergKernelGeneration.lean` at
`c561118b7795eb9780be9ed391c3251d6a4d0afd`, rewritten directly on `MilnorKTheory`.
-/
@[expose] public noncomputable section

universe u

namespace StableSteinberg.KernelGeneration

variable (F : Type u) [Field F]
attribute [local instance] kernelCommGroup

private def kernelDefectSubgroup : Subgroup ((toElementary F).ker) :=
  Subgroup.closure {g | ∃ a b : Fˣ, g = torusDefectKernel a b}

private def milnorToKernelMul : Multiplicative (MilnorKTheory F 2) →* (toElementary F).ker :=
  (milnorToKernel F).toMultiplicative

private lemma milnorToKernelMul_pair (a b : Fˣ) :
    milnorToKernelMul F (Multiplicative.ofAdd (milnorKTupleSymbol ![a, b])) =
      torusDefectKernel a b :=
  congrArg Additive.toMul (milnorToKernel_pair a b)

private lemma range_milnorToKernelMul : (milnorToKernelMul F).range = kernelDefectSubgroup F := by
  apply le_antisymm
  · let q := QuotientGroup.mk' (kernelDefectSubgroup F)
    have hz : q.toAdditive.comp (milnorToKernel F) = 0 := by
      apply milnorKTheory_addHom_ext
      intro a
      simp only [AddMonoidHom.comp_apply, milnorToKernel_symbol, AddMonoidHom.zero_apply]
      change q (torusDefectKernel (a 0) (a 1)) = 1
      apply (QuotientGroup.eq_one_iff _).mpr
      exact Subgroup.subset_closure ⟨a 0, a 1, rfl⟩
    rintro g ⟨a, rfl⟩
    apply (QuotientGroup.eq_one_iff _).mp
    exact congrArg Additive.toMul
      (congrArg (fun k : MilnorKTheory F 2 →+ Additive _ => k a.toAdd) hz)
  · apply (Subgroup.closure_le _).mpr
    rintro g ⟨a, b, rfl⟩
    exact ⟨Multiplicative.ofAdd (milnorKTupleSymbol ![a, b]), milnorToKernelMul_pair F a b⟩

private lemma map_kernelDefectSubgroup :
    (kernelDefectSubgroup F).map (toElementary F).ker.subtype = defectSubgroup F := by
  rw [kernelDefectSubgroup, MonoidHom.map_closure]
  congr 1
  ext g
  constructor
  · rintro ⟨z, ⟨a, b, rfl⟩, rfl⟩
    exact ⟨a, b, rfl⟩
  · rintro ⟨a, b, rfl⟩
    exact ⟨torusDefectKernel a b, ⟨a, b, rfl⟩, rfl⟩

/-- Surjectivity of the provided canonical Milnor map is equivalent to actual defect generation. -/
lemma milnorToKernel_surjective_iff :
    Function.Surjective (milnorToKernel F) ↔ defectSubgroup F = (toElementary F).ker := by
  constructor
  · intro hsurj
    have hrange : (milnorToKernelMul F).range = ⊤ := by
      apply MonoidHom.range_eq_top.mpr
      intro a
      obtain ⟨z, hz⟩ := hsurj (Additive.ofMul a)
      exact ⟨Multiplicative.ofAdd z, congrArg Additive.toMul hz⟩
    rw [← map_kernelDefectSubgroup, ← range_milnorToKernelMul, hrange,
      ← MonoidHom.range_eq_map]
    exact (toElementary F).ker.range_subtype
  · intro hgen a
    have ha : a.toMul ∈ kernelDefectSubgroup F := by
      have hmem : (a.toMul : Group F) ∈ defectSubgroup F := hgen.ge a.toMul.property
      rw [← map_kernelDefectSubgroup] at hmem
      obtain ⟨b, hb, heq⟩ := hmem
      have hbEq : b = a.toMul := Subtype.ext heq
      exact hbEq ▸ hb
    rw [← range_milnorToKernelMul] at ha
    obtain ⟨b, hb⟩ := ha
    exact ⟨b.toAdd, congrArg Additive.ofMul hb⟩

/-- The remaining all-rank generation problem is exactly containment of the full kernel in
stage two. -/
theorem milnorToKernel_surjective_iff_kernel_le_stage_two :
    Function.Surjective (milnorToKernel F) ↔ (toElementary F).ker ≤ stage F 2 := by
  rw [milnorToKernel_surjective_iff]
  constructor
  · intro hgen
    rw [← hgen]
    exact defectSubgroup_le_stage_two
  · intro hstage
    apply le_antisymm (defectSubgroup_le_kernel F)
    intro g hg
    exact stage_two_kernel_mem_defectSubgroup (hstage hg) hg

/-- The existing marked Milnor map is surjective over every field. Injectivity is separate. -/
theorem milnorToKernel_surjective : Function.Surjective (milnorToKernel F) :=
  (milnorToKernel_surjective_iff F).mpr (defectSubgroup_eq_kernel F)

end StableSteinberg.KernelGeneration

attribute [colib_ref "quillen"
  "Quillen/Algebra/Group/StableSteinbergKernelGeneration.lean, milnorToKernel_surjective"
  "adaptation" "Surjectivity of the unchanged ordered-symbol map, directly on native MilnorKTheory"]
  StableSteinberg.KernelGeneration.milnorToKernel_surjective
