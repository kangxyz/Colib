module

public import Colib.Util.References
public import Colib.KTheory.GrothendieckGroup.Abelian
public import StacksCore.CategoryTheory.GrothendieckGroup.SerreClass
public import StacksCore.CategoryTheory.Abelian.Subcategory
public import Mathlib.Algebra.Group.Subgroup.Map

/-!
# Object-generated subgroups and the Grothendieck group of a full subcategory

The image of the inclusion on the canonical Stacks Grothendieck group is exactly
the subgroup generated by classes of objects of the full subcategory. The
comparison with the standard abelian exact structure identifies the corresponding
subgroup in the conflation presentation, with its actual object generators.

The conflation-presentation subgroup is extracted from
`Quillen/Localization/Serre/Localization.lean`, declaration
`Quillen.SerreLocalization.serreSubgroup`, at commit
`c561118b7795eb9780be9ed391c3251d6a4d0afd`. Its unused localization data is not
introduced here. The image theorem and generator comparison are new adapters to
Stacks `f8e70c5dd04bfabcb423d5e325461f527c85a5d6`.

This file does not assert the localization exactness theorem or any homotopical
K-theory comparison.
-/

@[expose] public noncomputable section

universe v u

open CategoryTheory.Limits

namespace CategoryTheory.GrothendieckGroup

variable {A : Type u} [Category.{v} A] [HasZeroMorphisms A]
  (P : ObjectProperty A)
  (hι : ∀ ⦃S : ShortComplex P.FullSubcategory⦄,
    S.ShortExact → (S.map P.ι).ShortExact)

/-- The image of the inclusion is generated by the classes of its objects.
No Serre-class or abelian hypothesis is required once preservation of short exact
sequences by the inclusion is supplied. -/
theorem range_map_ι_eq_closure :
    (map P.ι hι).range =
      AddSubgroup.closure {a | ∃ X : A, P X ∧ a = of X} := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    induction x with
    | zero => simpa only [map_zero] using
        (AddSubgroup.zero_mem (AddSubgroup.closure {a | ∃ X : A, P X ∧ a = of X}))
    | of X =>
      rw [map_of]
      exact AddSubgroup.subset_closure ⟨X.obj, X.property, rfl⟩
    | neg X hX => simpa only [map_neg] using neg_mem hX
    | add x y hx hy => simpa only [map_add] using add_mem hx hy
  · apply (AddSubgroup.closure_le _).2
    rintro a ⟨X, hX, rfl⟩
    exact of_mem_range_map_ι P hι hX

end CategoryTheory.GrothendieckGroup

namespace CategoryTheory.ExactCategory

variable {A : Type u} [Category.{v} A] [Abelian A] (P : ObjectProperty A)

attribute [local instance] Abelian.hasFiniteBiproducts

/-- The subgroup generated by the conflation-presentation classes of objects in
`P`. For a Serre class this is the subgroup used by algebraic localization. -/
def serreSubgroup : AddSubgroup (abelianExactStructure A).GrothendieckGroup :=
  AddSubgroup.closure {a | ∃ X : A, P X ∧
    a = (abelianExactStructure A).grothendieckClass X}

/-- The comparison maps the specified object-generated subgroup to the image of
the full-subcategory inclusion on the canonical Stacks group. -/
theorem map_serreSubgroup_eq_range
    (hι : ∀ ⦃S : ShortComplex P.FullSubcategory⦄,
      S.ShortExact → (S.map P.ι).ShortExact) :
    (serreSubgroup P).map (abelianGrothendieckEquiv A).toAddMonoidHom =
      (CategoryTheory.GrothendieckGroup.map P.ι hι).range := by
  rw [serreSubgroup, AddMonoidHom.map_closure,
    CategoryTheory.GrothendieckGroup.range_map_ι_eq_closure]
  congr 1
  ext a
  constructor
  · rintro ⟨x, ⟨X, hX, rfl⟩, rfl⟩
    exact ⟨X, hX, abelianGrothendieckEquiv_class A X⟩
  · rintro ⟨X, hX, rfl⟩
    exact ⟨(abelianExactStructure A).grothendieckClass X, ⟨X, hX, rfl⟩,
      abelianGrothendieckEquiv_class A X⟩

/-- On an actual object of the full subcategory, the inclusion map and the
conflation-presentation comparison produce the same generator. -/
theorem map_ι_of_eq_abelianGrothendieckEquiv_class
    (hι : ∀ ⦃S : ShortComplex P.FullSubcategory⦄,
      S.ShortExact → (S.map P.ι).ShortExact) (X : P.FullSubcategory) :
    CategoryTheory.GrothendieckGroup.map P.ι hι
        (CategoryTheory.GrothendieckGroup.of X) =
      abelianGrothendieckEquiv A ((abelianExactStructure A).grothendieckClass X.obj) := by
  simp

/-- The Serre-class specialization uses the upstream exactness proof for the
inclusion; no additional assumption about that functor is introduced. -/
theorem map_serreSubgroup_eq_range_of_isSerreClass [P.IsSerreClass] :
    (serreSubgroup P).map (abelianGrothendieckEquiv A).toAddMonoidHom =
      (CategoryTheory.GrothendieckGroup.map P.ι P.shortExact_map_ι).range :=
  map_serreSubgroup_eq_range P P.shortExact_map_ι

end CategoryTheory.ExactCategory

attribute [colib_tag "COL-0026",
  colib_ref "WeibelKBook" "II, Definition 6.1.1 and paragraph 6.1.5" "adaptation"
    "Inclusion image generated by object classes, with explicit short-exact preservation"]
  CategoryTheory.GrothendieckGroup.range_map_ι_eq_closure

attribute [colib_tag "COL-0026"]
  CategoryTheory.ExactCategory.serreSubgroup
  CategoryTheory.ExactCategory.map_serreSubgroup_eq_range
  CategoryTheory.ExactCategory.map_ι_of_eq_abelianGrothendieckEquiv_class

attribute [colib_tag "COL-0026",
  stacks 02MX "(1), input subgroup comparison only; no localization exactness claim"]
  CategoryTheory.ExactCategory.map_serreSubgroup_eq_range_of_isSerreClass
