module

public import Colib.Topology.LocalCoefficients.Functoriality
public import Mathlib.Algebra.Module.ULift
public import Mathlib.LinearAlgebra.Finsupp.Defs

/-!
# Integral generators and naturality of singular chains

Extracted from the integral-coefficient declarations of
`Quillen/Topology/LocalCoefficients/RegularChains.lean` and `RegularFunctoriality.lean`
at commit `c561118b7795eb9780be9ed391c3251d6a4d0afd`. The unrelated regular-system
construction is not imported. Coefficients remain the original lifted integers,
and the comparison retains Mathlib's singular-chain map.
-/

@[expose] public noncomputable section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.defeqAttrib.useBackward true

open CategoryTheory Limits Opposite
open scoped Simplicial

universe u

namespace FundamentalGroupoid.LocalCoefficients

variable {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y]

/-- The integral coefficient module, in the same universe as the chains. -/
abbrev integralCoefficients : ModuleCat.{u} ℤ := ModuleCat.of ℤ (ULift.{u} ℤ)

/-- Ordinary integral generator in the original coproduct chain model. -/
def integralChainGenerator {n : SimplexCategory} (σ : SingularSimplex X n)
    (z : ℤ) : chainModule (constant X integralCoefficients) n :=
  chainInclusion (constant X integralCoefficients) σ (ULift.up z)

/-- Flatten ordinary integral chains without changing their actual simplex index. -/
def integralBasisHom (n : SimplexCategory) :
    chainModule (constant X integralCoefficients) n ⟶
      ModuleCat.of ℤ (SingularSimplex X n →₀ ℤ) :=
  Sigma.desc fun σ ↦ ModuleCat.ofHom
    ((Finsupp.lsingle σ).comp (ULift.moduleEquiv.toLinearMap))

/-- The inverse inserts each ordinary simplex with its integral coefficient. -/
def integralBasisInv (n : SimplexCategory) :
    ModuleCat.of ℤ (SingularSimplex X n →₀ ℤ) ⟶
      chainModule (constant X integralCoefficients) n :=
  ModuleCat.ofHom (Finsupp.lsum ℕ fun σ ↦
    (chainInclusion (constant X integralCoefficients) σ).hom.comp
      ULift.moduleEquiv.symm.toLinearMap)

@[simp]
theorem integralBasisHom_generator {n : SimplexCategory} (σ : SingularSimplex X n)
    (z : ℤ) :
    integralBasisHom n (integralChainGenerator σ z) = Finsupp.single σ z := by
  change (chainInclusion (constant X integralCoefficients) σ ≫ integralBasisHom n)
    (ULift.up z) = _
  simp [integralBasisHom, chainInclusion, ULift.moduleEquiv]

@[simp]
theorem integralBasisInv_single {n : SimplexCategory} (σ : SingularSimplex X n)
    (z : ℤ) :
    integralBasisInv n (Finsupp.single σ z) = integralChainGenerator σ z := by
  exact Finsupp.lsum_single (S := ℕ) (R := ℤ) _ _ _

/-- Ordinary integral chains are freely generated by actual singular simplices. -/
def integralBasisIso (n : SimplexCategory) :
    chainModule (constant X integralCoefficients) n ≅
      ModuleCat.of ℤ (SingularSimplex X n →₀ ℤ) where
  hom := integralBasisHom n
  inv := integralBasisInv n
  hom_inv_id := by
    apply Sigma.hom_ext
    intro σ
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro z
    change integralBasisInv n (integralBasisHom n
      (integralChainGenerator σ z.down)) = integralChainGenerator σ z.down
    rw [integralBasisHom_generator, integralBasisInv_single]
  inv_hom_id := by
    apply ModuleCat.hom_ext
    apply Finsupp.lhom_ext
    intro σ z
    change integralBasisHom n (integralBasisInv n (Finsupp.single σ z)) = _
    rw [integralBasisInv_single, integralBasisHom_generator]
    rfl

/-- Ordinary restriction leaves the integral coefficient unchanged. -/
@[simp]
theorem chainMap_integralGenerator {m n : SimplexCategory}
    (σ : SingularSimplex X n) (α : m ⟶ n) (z : ℤ) :
    chainMap (constant X integralCoefficients) α (integralChainGenerator σ z) =
      integralChainGenerator (restrictSimplex σ α) z := by
  change (chainInclusion (constant X integralCoefficients) σ ≫
    chainMap (constant X integralCoefficients) α) (ULift.up z) = _
  rw [chainInclusion_chainMap]
  rfl

/-- Ordinary pushforward retains both the original map and the integral coefficient. -/
@[simp]
theorem pushforwardModuleMap_integralGenerator (f : C(X, Y)) {n : SimplexCategory}
    (σ : SingularSimplex X n) (z : ℤ) :
    pushforwardModuleMap f (constant Y integralCoefficients) n
        (integralChainGenerator σ z) = integralChainGenerator (f.comp σ) z := by
  change (chainInclusion (pullback f (constant Y integralCoefficients)) σ ≫
    pushforwardModuleMap f (constant Y integralCoefficients) n) (ULift.up z) = _
  rw [chainInclusion_pushforwardModuleMap]
  rfl

/-- Ordinary-chain reindexing respects the original continuous map at the simplicial level. -/
@[reassoc]
theorem constantSimplicialIso_naturality (f : C(X, Y)) (V : ModuleCat.{u} ℤ) :
    pushforwardSimplicialMap f (constant Y V) ≫ (constantSimplicialIso V).hom =
      (constantSimplicialIso V).hom ≫
        Functor.whiskerRight (TopCat.toSSet.map (TopCat.ofHom f)) (sigmaConst.obj V) := by
  ext n : 1
  apply Sigma.hom_ext
  intro σ
  simp [pushforwardSimplicialMap, constantSimplicialIso, constantModuleIso,
    pushforwardModuleMap, chainInclusion, sigmaConst, Sigma.map', constant]
  rfl

/-- The standard comparison retains mathlib's actual singular-chain map of the original map. -/
@[reassoc]
theorem constantChainComplexIso_naturality (f : C(X, Y)) (V : ModuleCat.{u} ℤ) :
    pushforwardChainMap f (constant Y V) ≫ (constantChainComplexIso V).hom =
      (constantChainComplexIso V).hom ≫
        ((AlgebraicTopology.singularChainComplexFunctor (ModuleCat.{u} ℤ)).obj V).map
          (TopCat.ofHom f) := by
  have h := congrArg (fun η ↦ (AlgebraicTopology.alternatingFaceMapComplex
    (ModuleCat.{u} ℤ)).map η) (constantSimplicialIso_naturality f V)
  simpa [pushforwardChainMap, constantChainComplexIso,
    AlgebraicTopology.singularChainComplexFunctor, SSet.chainComplexFunctor] using h

end FundamentalGroupoid.LocalCoefficients
