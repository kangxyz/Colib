  colib_ref "WeibelKBook" "IV, Proposition 6.2 and proof, equations (6.2.1)-(6.2.2), page 54"
    "adaptation"
    "Object-loop relations and comparison map only; its image is the object-loop subgroup"]
  CategoryTheory.ExactCategory.ExactStructure.kZeroObjectClass
  CategoryTheory.ExactCategory.ExactStructure.kZeroObjectClass_conflation
  CategoryTheory.ExactCategory.ExactStructure.grothendieckToKZero
  CategoryTheory.ExactCategory.ExactStructure.grothendieckToKZero_class
  CategoryTheory.ExactCategory.ExactStructure.grothendieckToKZero_range
