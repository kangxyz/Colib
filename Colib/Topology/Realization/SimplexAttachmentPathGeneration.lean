module

public import Colib.Util.References
public import Colib.Topology.Realization.SimplexAttachmentCover
public import Colib.Topology.Homotopy.OpenCoverFull
public import Colib.Topology.Realization.SimplexAttachmentDeformation
public import Mathlib.AlgebraicTopology.FundamentalGroupoid.InducedMaps

/-!
# Continuous paths in simplex attachments are generated by cell paths

For an actual simplex-attachment pushout, every continuous path class is
generated by paths from the old space and paths in individual geometric
simplices. The proof uses the genuine open collar deformation and interior
charts, together with compact open-cover subdivision. There is no cellular or
piecewise-linear approximation assumption on the original path.
-/
/-!
Adapted from `Quillen/Topology/Realization/EdgePathPresentation/CellPathGeneration.lean`
at commit `c561118b7795eb9780be9ed391c3251d6a4d0afd`.
Actual cell maps, endpoint tracks and relative homotopy classes are retained.
The source path, endpoint and dimension hypotheses are retained.
-/
@[expose] public section

noncomputable section
universe u
open CategoryTheory CategoryTheory.Limits Convexity.StdSimplex Topology Set
open scoped Topology unitInterval
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
namespace TopCat

section SimplexAttachment
variable (X : TopCat.{u}) [DiscreteTopology X] (n : ℕ) {C D : TopCat.{u}}
    {f : TopCat.of (X × Convexity.StdSimplex.boundary n) ⟶ C}
    {g : TopCat.of (X × Convexity.StdSimplex ℝ (Fin (n + 1))) ⟶ D}
    {j : C ⟶ D}
    (sq : IsPushout (parameterizedSimplexBoundaryInclusion X n) f g j)

/-- The full geometric characteristic map of one attached simplex. -/
def simplexAttachmentCellMap (a : X) : C(Convexity.StdSimplex ℝ (Fin (n + 1)), D) where
  toFun x := g (a, x)
  continuous_toFun := g.hom.continuous.comp (continuous_const.prodMk continuous_id)

variable (S : Subgroupoid (FundamentalGroupoid D))
    (hold : ∀ {x y : C} (p : Path x y),
      (⟦p.map j.hom.continuous⟧ : FundamentalGroupoid.mk (j x) ⟶
        FundamentalGroupoid.mk (j y)) ∈ S.arrows _ _)
    (hcell : ∀ (a : X) {x y : Convexity.StdSimplex ℝ (Fin (n + 1))} (p : Path x y),
      (⟦p.map (simplexAttachmentCellMap X n (g := g) a).continuous⟧ :
        FundamentalGroupoid.mk (g (a, x)) ⟶ FundamentalGroupoid.mk (g (a, y))) ∈ S.arrows _ _)

omit [DiscreteTopology X] in
include hold hcell in
/-- Every radial-deformation track is already an old-space or single-cell path. -/
theorem simplexAttachment_radial_path_mem (z : D) :
    (⟦(simplexAttachmentRadialHomotopy X n sq).evalAt z⟧ :
      FundamentalGroupoid.mk z ⟶
        FundamentalGroupoid.mk (simplexAttachmentRadial X n sq (1, z))) ∈ S.arrows _ _ := by
  rcases Types.eq_or_eq_of_isPushout (sq.map (forget TopCat)) z with ⟨b, hb⟩ | ⟨c, hc⟩
  · change g b = z at hb
    subst z
    let p : Path b.2 (simplexBoundaryRetractPoint (b.2, 1)) := {
      toFun t := simplexBoundaryRetractPoint (b.2, t)
      continuous_toFun := by fun_prop
      source' := simplexBoundaryRetractPoint_zero b.2
      target' := rfl }
    apply FundamentalGroupoid.pathClass_mem_of_pointwise_eq S _
      (p.map (simplexAttachmentCellMap X n (g := g) b.1).continuous)
    · intro t
      exact simplexAttachmentRadial_cell X n sq t b
    · exact hcell b.1 p
  · change j c = z at hc
    subst z
    apply FundamentalGroupoid.pathClass_mem_of_pointwise_eq S _ ((Path.refl c).map j.hom.continuous)
    · intro t
      exact simplexAttachmentRadial_old X n sq t c
    · exact hold (Path.refl c)

omit [DiscreteTopology X] in
include hold hcell in
/-- A path lying in the actual open collar is generated by the old-space path
obtained by retraction and the two genuine endpoint tracks. -/
theorem simplexAttachment_collar_path_mem {x y : D} (p : Path x y)
    (hp : Set.range p ⊆ simplexAttachmentCollar X n sq) :
    (⟦p⟧ : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk y) ∈ S.arrows _ _ := by
  let U := simplexAttachmentCollar X n sq
  let x' : U := ⟨x, hp p.source_mem_range⟩
  let y' : U := ⟨y, hp p.target_mem_range⟩
  let q : Path x' y' := Path.inSubset p hp
  let r : C(D, D) := ⟨fun z ↦ simplexAttachmentRadial X n sq (1, z),
    (simplexAttachmentRadial X n sq).continuous.comp (continuous_const.prodMk continuous_id)⟩
  let H := simplexAttachmentRadialHomotopy X n sq
  have hr : (⟦p.map r.continuous⟧ :
      FundamentalGroupoid.mk (r x) ⟶ FundamentalGroupoid.mk (r y)) ∈ S.arrows _ _ := by
    apply FundamentalGroupoid.pathClass_mem_of_pointwise_eq S _
      ((q.map (simplexAttachmentCollarRetraction X n sq).continuous).map j.hom.continuous)
    · intro t
      exact (simplexAttachmentCollarRetractionFun_spec X n sq (q t)).symm
    · exact hold _
  have hnat := (H.eq_diag_path (⟦p⟧ : FundamentalGroupoid.mk x ⟶
    FundamentalGroupoid.mk y)).1.trans
      (H.eq_diag_path (⟦p⟧ : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk y)).2.symm
  have htracks := S.mul (simplexAttachment_radial_path_mem X n sq S hold hcell x) hr
  have hnat' : (Path.Homotopic.Quotient.mk p).trans
      (Path.Homotopic.Quotient.mk (H.evalAt y)) =
      (Path.Homotopic.Quotient.mk (H.evalAt x)).trans
        (Path.Homotopic.Quotient.mk (p.map r.continuous)) := by
    change ((Path.Homotopic.Quotient.mk p).map (ContinuousMap.id D)).trans
      (Path.Homotopic.Quotient.mk (H.evalAt y)) =
      (Path.Homotopic.Quotient.mk (H.evalAt x)).trans
        ((Path.Homotopic.Quotient.mk p).map r) at hnat
    simpa only [← Path.Homotopic.Quotient.mk_map, Path.map_id] using hnat
  change (Path.Homotopic.Quotient.mk (H.evalAt x)).trans
    (Path.Homotopic.Quotient.mk (p.map r.continuous)) ∈ S.arrows _ _ at htracks
  rw [← hnat'] at htracks
  exact (S.mul_mem_cancel_right
    (simplexAttachment_radial_path_mem X n sq S hold hcell y)).mp htracks

include sq hcell in
/-- A path in an open cell interior lifts through its actual chart and hence
is generated by a path in that geometric simplex. -/
theorem simplexAttachment_interior_path_mem (a : X) {x y : D} (p : Path x y)
    (hp : Set.range p ⊆ simplexAttachmentInterior X n (g := g) a) :
    (⟦p⟧ : FundamentalGroupoid.mk x ⟶ FundamentalGroupoid.mk y) ∈ S.arrows _ _ := by
  let V := simplexAttachmentInterior X n (g := g) a
  let e := (isOpenEmbedding_simplexAttachmentInteriorMap X n sq a).isEmbedding.toHomeomorph
  let x' : V := ⟨x, hp p.source_mem_range⟩
  let y' : V := ⟨y, hp p.target_mem_range⟩
  let q := ((Path.inSubset (x := x') (y := y') p hp).map e.symm.continuous).map
    continuous_subtype_val
  apply FundamentalGroupoid.pathClass_mem_of_pointwise_eq S p
    (q.map (simplexAttachmentCellMap X n (g := g) a).continuous)
  · intro t
    exact (congrArg Subtype.val (e.apply_symm_apply
      (⟨p t, hp (Set.mem_range_self t)⟩ : V))).symm
  · exact hcell a q

include sq hold hcell in
/-- Old-space paths and paths in the actual attached simplices generate every
continuous path-homotopy class in an arbitrary discrete simplex attachment. -/
theorem simplexAttachment_subgroupoid_eq_top : S = ⊤ := by
  let W : Option X → Set D := fun a ↦ a.elim (simplexAttachmentCollar X n sq)
    (simplexAttachmentInterior X n (g := g))
  apply FundamentalGroupoid.subgroupoid_eq_top_of_openCover S W
  · rintro (_ | a)
    · exact isOpen_simplexAttachmentCollar X n sq
    · exact isOpen_simplexAttachmentInterior X n sq a
  · intro z _
    have hz : z ∈ simplexAttachmentCollar X n sq ∪
        ⋃ a, simplexAttachmentInterior X n (g := g) a := by
      rw [simplexAttachmentCollar_union_interiors X n sq]
      trivial
    rcases hz with hz | hz
    · exact Set.mem_iUnion.mpr ⟨none, hz⟩
    · obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hz
      exact Set.mem_iUnion.mpr ⟨some a, ha⟩
  · rintro (_ | a) x y p hp
    · exact simplexAttachment_collar_path_mem X n sq S hold hcell p hp
    · exact simplexAttachment_interior_path_mem X n sq S hcell a p hp

end SimplexAttachment
end TopCat

attribute [colib_tag "COL-0105",
  colib_ref "HatcherAT" "Section 1.1, proof of Lemma 1.15, page 35"
    "background"
    "Open-cover subdivision for generation by old-space and full geometric-cell paths"]
  TopCat.simplexAttachment_subgroupoid_eq_top

attribute [colib_tag "COL-0105",
  colib_ref "HatcherAT" "Section 1.1, Lemma 1.19, page 37"
    "background"
    "Two-endpoint track transport in the groupoid, compared with the based-loop formula"]
  TopCat.simplexAttachment_radial_path_mem
  TopCat.simplexAttachment_collar_path_mem
