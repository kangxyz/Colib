module

public import Mathlib.Algebra.Category.ModuleCat.ChangeOfRings
public import Mathlib.RingTheory.TensorProduct.Quotient

/-!
# Scalar extension of the actual quotient module

The comparison is Mathlib's tensor/quotient equivalence, with its literal pure-tensor formula.
No localization or flatness hypothesis is needed.
-/

@[expose] public noncomputable section

open CategoryTheory
open scoped TensorProduct

universe u

namespace ModuleCat

variable {R A : Type u} [CommRing R] [CommRing A] [Algebra R A]

set_option backward.isDefEq.respectTransparency false in
/-- The actual scalar extension of a quotient is the quotient by the extended ideal. -/
def extendScalarsQuotientIso (I : Ideal R) :
    (extendScalars (algebraMap R A)).obj (of R (R ⧸ I)) ≅
      of A (A ⧸ I.map (algebraMap R A)) := by
  letI : Algebra R A := (algebraMap R A).toAlgebra
  exact (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A I).symm.toLinearEquiv.toModuleIso

/-- A pure tensor maps to the product of its two representatives in the extended quotient. -/
@[simp]
theorem extendScalarsQuotientIso_hom_tmul (I : Ideal R) (a : A) (r : R) :
    (extendScalarsQuotientIso (A := A) I).hom (a ⊗ₜ[R] (Ideal.Quotient.mk I r)) =
      Ideal.Quotient.mk (I.map (algebraMap R A)) (algebraMap R A r * a) := by
  rfl

/-- For a finite sequence, the extended ideal is generated by its literal base-changed entries. -/
theorem map_span_range_algebraMap {n : ℕ} (f : Fin n → R) :
    (Ideal.span (Set.range f)).map (algebraMap R A) =
      Ideal.span (Set.range (fun i => algebraMap R A (f i))) := by
  rw [Ideal.map_span, ← Set.range_comp]
  rfl

end ModuleCat
