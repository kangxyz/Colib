module

public import Colib.GroupTheory.StableGeneralLinear.Basic
public import Colib.LinearAlgebra.Matrix.GeneralLinearGroup.Elementary

/-!
# The stable elementary subgroup and its canonical generators

The subgroup is generated by the images of the native finite elementary units in
the actual matrix direct limit. Stabilization with a fresh index proves its
perfectness over any ring. Every ring map preserves this actual subgroup.

## Implementation provenance

Adapted from `Quillen/Algebra/Group/StableElementary.lean` at
`c561118b7795eb9780be9ed391c3251d6a4d0afd`. The elementary commutator inclusion
is proved here. Whitehead's reverse inclusion and normality are not asserted.
-/
@[expose] public section

universe u

noncomputable section

namespace StableGeneralLinear

open scoped commutatorElement

variable (R : Type u) [Ring R]

/-- Block stabilization preserves the positions of a native elementary matrix. -/
lemma step_elementary (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : R) :
    step R n (Matrix.GeneralLinearGroup.elementary i j hij a) =
      Matrix.GeneralLinearGroup.elementary i.castSucc j.castSucc (by simpa using hij) a := by
  apply Units.ext
  ext k l
  cases k using Fin.lastCases <;> cases l using Fin.lastCases <;>
    simp [Matrix.GeneralLinearGroup.elementary_val, Matrix.single, Matrix.one_apply, eq_comm]

/-- The subgroup generated by the actual stable elementary matrices. -/
def elementary : Subgroup (Group R) :=
  Subgroup.closure {g | ∃ (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : R),
    g = of R n (Matrix.GeneralLinearGroup.elementary i j hij a)}

lemma unit_mem_elementary (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : R) :
    of R n (Matrix.GeneralLinearGroup.elementary i j hij a) ∈ elementary R :=
  Subgroup.subset_closure ⟨n, i, j, hij, a, rfl⟩

/-- Finite elementary subgroups map into the stable elementary subgroup. -/
lemma of_elementary_le (n : ℕ) :
    (Matrix.GeneralLinearGroup.elementarySubgroup (Fin n) R).map (of R n) ≤ elementary R := by
  rw [Subgroup.map_le_iff_le_comap]
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨i, j, hij, a, rfl⟩
  exact unit_mem_elementary R n i j hij a

lemma of_mem_elementary {n : ℕ} {g : Matrix.GeneralLinearGroup (Fin n) R}
    (hg : g ∈ Matrix.GeneralLinearGroup.elementarySubgroup (Fin n) R) : of R n g ∈ elementary R :=
  of_elementary_le R n (Subgroup.mem_map_of_mem (of R n) hg)

lemma of_elementary_succ (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : R) :
    of R (n + 1) (Matrix.GeneralLinearGroup.elementary i.castSucc j.castSucc (by simpa using
      hij) a) =
      of R n (Matrix.GeneralLinearGroup.elementary i j hij a) := by
  rw [← step_elementary]
  simpa only [transition_succ] using
    of_transition R (Nat.le_succ n) (Matrix.GeneralLinearGroup.elementary i j hij a)

/-- A newly adjoined coordinate expresses any stable generator as an elementary commutator. -/
lemma unit_mem_elementary_commutator (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : R) :
    of R n (Matrix.GeneralLinearGroup.elementary i j hij a) ∈ ⁅elementary R, elementary R⁆ := by
  have hi : i.castSucc ≠ Fin.last n := Fin.castSucc_ne_last i
  have hj : Fin.last n ≠ j.castSucc := (Fin.castSucc_ne_last j).symm
  have hij' : i.castSucc ≠ j.castSucc := by simpa using hij
  have h := Subgroup.commutator_mem_commutator
    (unit_mem_elementary R (n + 1) i.castSucc (Fin.last n) hi a)
    (unit_mem_elementary R (n + 1) (Fin.last n) j.castSucc hj (1 : R))
  rw [← map_commutatorElement, Matrix.GeneralLinearGroup.elementary_commutator
    i.castSucc (Fin.last n) j.castSucc hi hj hij', mul_one, of_elementary_succ] at h
  exact h

/-- The stable elementary group is perfect for every ring, including the zero ring. -/
instance elementary_isPerfect : _root_.Group.IsPerfect (elementary R) := by
  apply Subgroup.isPerfect_iff.mpr
  apply le_antisymm (Subgroup.commutator_le_of_le le_rfl le_rfl)
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨n, i, j, hij, a, rfl⟩
  exact unit_mem_elementary_commutator R n i j hij a

/-- The elementary subgroup is contained in the stable commutator subgroup. -/
lemma elementary_le_commutator : elementary R ≤ commutator (Group R) := by
  rw [← Subgroup.commutator_eq_self (H := elementary R), commutator_def]
  exact Subgroup.commutator_mono le_top le_top

section RingMap

variable {R} {S : Type*} [Ring S]

/-- Every ring homomorphism preserves the actual stable elementary subgroup. -/
lemma map_elementary_le (f : R →+* S) :
    (elementary R).map (map f) ≤ elementary S := by
  rw [Subgroup.map_le_iff_le_comap]
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨n, i, j, hij, a, rfl⟩
  change map f (of R n (Matrix.GeneralLinearGroup.elementary i j hij a)) ∈ elementary S
  rw [map_of]
  change of S n (Units.map (RingHom.mapMatrix f).toMonoidHom
    (Matrix.GeneralLinearGroup.elementary i j hij a)) ∈ elementary S
  rw [Matrix.GeneralLinearGroup.mapMatrixUnits_elementary]
  exact unit_mem_elementary S n i j hij (f a)

end RingMap

end StableGeneralLinear
