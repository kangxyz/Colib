module

public import Colib.Topology.ClassifyingSpace.NerveCompletion.OriginalArrowLift
public import Colib.CategoryTheory.Groupoid.JointRepresentatives

/-!
# Nerve Joint Data

The specified original graph vertex of each actual localization object.
-/

@[expose] public section

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open CategoryTheory FundamentalGroupoid.OpenCover Convexity.StdSimplex.Boundary
universe u v
namespace CategoryTheory.NerveCompletion
open FundamentalGroupoid.OpenCover
open TopCat.SimplexAttachment
open Convexity.StdSimplex.Boundary
open FundamentalGroupoid.SequentialColimit
open CategoryTheory.Groupoid.JointRepresentation
attribute [local instance] Localization.groupoid

/-- The specified original graph vertex of each actual localization object. -/
def localizedGraphObject (C : Type u) [Category.{v} C]
    (X : (⊤ : MorphismProperty C).Localization) : FundamentalGroupoid (NerveGraphData.Stage C) :=
  FundamentalGroupoid.mk (graphVertex C
    ((Localization.Construction.objEquiv (⊤ : MorphismProperty C)).symm X))

/-- The original graph decoder's exact localization-object identification. -/
def localizedGraphIso (C : Type u) [Category.{v} C]
    (X : (⊤ : MorphismProperty C).Localization) :
    (nerveGraphDecoder C).obj (localizedGraphObject C X) ≅ X :=
  graphVertexIso C ((Localization.Construction.objEquiv (⊤ : MorphismProperty C)).symm X)

/-- The original ambient classifying-space vertex identification. -/
def localizedAmbientIso (C : Type u) [Category.{v} C]
    (X : (⊤ : MorphismProperty C).Localization) :
    (FundamentalGroupoid.map (NerveGraphData.inclusion C)).obj (localizedGraphObject C X) ≅
      (classifyingGroupoidCompletionFunctor C).obj X :=
  graphAmbientIso C ((Localization.Construction.objEquiv (⊤ : MorphismProperty C)).symm X)

/-- Joint representation property for the UNCHANGED original completion functor. -/
def nerveJointProperty (C : Type u) [Category.{v} C] :
    MorphismProperty (⊤ : MorphismProperty C).Localization :=
  jointProperty (nerveGraphDecoder C) (FundamentalGroupoid.map (NerveGraphData.inclusion C))
    (classifyingGroupoidCompletionFunctor C) (localizedGraphObject C)
    (localizedGraphIso C) (localizedAmbientIso C)

/-- Every original categorical arrow has a joint representative in the actual graph. -/
theorem nerveJointProperty_arrow (C : Type u) [Category.{v} C] {c d : C} (f : c ⟶ d) :
    nerveJointProperty C ((⊤ : MorphismProperty C).Q.map f) := by
  obtain ⟨p, hp⟩ := originalArrow_graph_path C f
  refine ⟨Path.Homotopic.Quotient.mk p, ?_, ?_⟩
  · exact decoder_trace_of_simplex C (ComposableArrows.mk₁ f) p hp
  · change (FundamentalGroupoid.map (NerveGraphData.inclusion C)).map
        (Path.Homotopic.Quotient.mk p) = (graphAmbientIso C c).hom ≫
          ((⊤ : MorphismProperty C).Q ⋙ classifyingGroupoidCompletionFunctor C).map f ≫
          (graphAmbientIso C d).inv
    have hf : ((⊤ : MorphismProperty C).Q ⋙ classifyingGroupoidCompletionFunctor C).map f =
        (classifyingFundamentalGroupoidFunctor C).map f := by
      simpa only [eqToHom_refl, Category.id_comp, Category.comp_id] using
        Functor.congr_hom (toClassifyingGroupoidCompletionFunctor C) f
    rw [hf]
    exact originalArrow_ambient_trace C f p hp

/-- All localized morphisms have a joint representative: the property is proved
stable under composition and inverse, and Mathlib's original localization
construction is generated by the original arrows and their formal inverses. -/
theorem nerveJointProperty_all (C : Type u) [Category.{v} C] : nerveJointProperty C = ⊤ := by
  let : (nerveJointProperty C).IsStableUnderComposition :=
    jointProperty_comp (nerveGraphDecoder C)
      (FundamentalGroupoid.map (NerveGraphData.inclusion C))
      (classifyingGroupoidCompletionFunctor C) (localizedGraphObject C)
      (localizedGraphIso C) (localizedAmbientIso C)
  apply Localization.Construction.morphismProperty_eq_top'
  · intro c d f
    exact nerveJointProperty_arrow C f
  · intro X Y e he
    exact jointProperty_inv (nerveGraphDecoder C)
      (FundamentalGroupoid.map (NerveGraphData.inclusion C))
      (classifyingGroupoidCompletionFunctor C) (localizedGraphObject C)
      (localizedGraphIso C) (localizedAmbientIso C) e he

end CategoryTheory.NerveCompletion
