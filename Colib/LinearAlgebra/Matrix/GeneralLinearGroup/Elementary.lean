module

public import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs
public import Mathlib.GroupTheory.IsPerfect
public import Mathlib.Tactic.Abel

/-!
# Elementary units in the native general linear group

Elementary matrices are constructed as actual units in the matrix ring, with
explicit inverses. The Steinberg commutator relation retains the order of its
coefficients and requires no commutativity of the ring. The subgroup generated
by elementary matrices is perfect whenever there is a third index distinct
from any given pair. Normality in the full general linear group is not asserted
at finite rank.

## Implementation provenance

Adapted from `Quillen/Aglib/LinearAlgebra/Matrix/Elementary.lean` at
`c561118b7795eb9780be9ed391c3251d6a4d0afd`. The native general linear group is
used directly. The entrywise maps are Mathlib's `Units.map` and `RingHom.mapMatrix`.
-/
@[expose] public section

universe u v

namespace Matrix.GeneralLinearGroup

open scoped commutatorElement

variable {R : Type u} [Ring R] {n : Type v} [Fintype n] [DecidableEq n]

local notation "elementaryMatrix" => fun i j a => (1 + Matrix.single i j a)

omit [Fintype n] in
lemma elementaryMatrix_zero (i j : n) : elementaryMatrix i j (0 : R) = 1 := by
  simp [Matrix.single_zero]

/-- Addition of coefficients is multiplication of elementary matrices. -/
lemma elementaryMatrix_mul_same (i j : n) (hij : i ≠ j) (a b : R) :
    elementaryMatrix i j a * elementaryMatrix i j b = elementaryMatrix i j (a + b) := by
  simp [add_mul, mul_add, hij.symm, Matrix.single_add, add_assoc]

/-- An elementary matrix as a unit, using the negative coefficient for its inverse. -/
def elementary (i j : n) (hij : i ≠ j) (a : R) : Matrix.GeneralLinearGroup n R where
  val := elementaryMatrix i j a
  inv := elementaryMatrix i j (-a)
  val_inv := by rw [elementaryMatrix_mul_same i j hij, add_neg_cancel, elementaryMatrix_zero]
  inv_val := by rw [elementaryMatrix_mul_same i j hij, neg_add_cancel, elementaryMatrix_zero]

@[simp] lemma elementary_val (i j : n) (hij : i ≠ j) (a : R) :
    (elementary i j hij a).val = elementaryMatrix i j a := rfl

@[simp] lemma elementary_inv (i j : n) (hij : i ≠ j) (a : R) :
    (elementary i j hij a)⁻¹ = elementary i j hij (-a) := by
  apply Units.ext
  rfl

@[simp] lemma elementary_zero (i j : n) (hij : i ≠ j) : elementary i j hij (0 : R) = 1 := by
  apply Units.ext
  exact elementaryMatrix_zero i j

lemma elementary_mul_same (i j : n) (hij : i ≠ j) (a b : R) :
    elementary i j hij a * elementary i j hij b = elementary i j hij (a + b) := by
  apply Units.ext
  exact elementaryMatrix_mul_same i j hij a b

/-- Elementary matrices with disjoint interacting indices commute. -/
lemma elementary_commute (i j k l : n) (hij : i ≠ j) (hkl : k ≠ l)
    (hjk : j ≠ k) (hli : l ≠ i) (a b : R) :
    Commute (elementary i j hij a) (elementary k l hkl b) := by
  apply Units.ext
  change elementaryMatrix i j a * elementaryMatrix k l b = elementaryMatrix k l b *
    elementaryMatrix i j a
  simp [add_mul, mul_add, hjk, hli]
  abel

/-- The Steinberg relation over a possibly noncommutative ring. -/
lemma elementary_commutator (i j k : n) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k)
    (a b : R) :
    ⁅elementary i j hij a, elementary j k hjk b⁆ = elementary i k hik (a * b) := by
  apply Units.ext
  simp only [commutatorElement_def, Units.val_mul, elementary_inv, elementary_val]
  simp [add_mul, mul_add, hij.symm, hjk.symm, hik.symm,
    ← Matrix.single_neg]
  abel

/-- The genuine elementary subgroup, generated by the elementary matrix units. -/
def elementarySubgroup (n : Type v) [Fintype n] [DecidableEq n] (R : Type u) [Ring R] :
    Subgroup (Matrix.GeneralLinearGroup n R) :=
  Subgroup.closure {g | ∃ (i j : n) (hij : i ≠ j) (a : R), g = elementary i j hij a}

lemma elementary_mem_subgroup (i j : n) (hij : i ≠ j) (a : R) :
    elementary i j hij a ∈ elementarySubgroup n R :=
  Subgroup.subset_closure ⟨i, j, hij, a, rfl⟩

/-- Every generator is a commutator of elementary matrices when a spare index exists. -/
lemma elementary_mem_commutator (i j k : n) (hij : i ≠ j) (hik : i ≠ k) (hkj : k ≠ j)
    (a : R) : elementary i j hij a ∈ ⁅elementarySubgroup n R, elementarySubgroup n R⁆ := by
  have h := Subgroup.commutator_mem_commutator
    (elementary_mem_subgroup i k hik a) (elementary_mem_subgroup k j hkj (1 : R))
  rw [elementary_commutator i k j hik hkj hij, mul_one] at h
  exact h

/-- Perfectness of the elementary subgroup, with the precise index hypothesis. -/
theorem elementarySubgroup_isPerfect
    (hthird : ∀ i j : n, i ≠ j → ∃ k : n, i ≠ k ∧ k ≠ j) :
    Group.IsPerfect (elementarySubgroup n R) := by
  apply Subgroup.isPerfect_iff.mpr
  apply le_antisymm (Subgroup.commutator_le_of_le le_rfl le_rfl)
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨i, j, hij, a, rfl⟩
  obtain ⟨k, hik, hkj⟩ := hthird i j hij
  exact elementary_mem_commutator i j k hij hik hkj a

section RingMap

variable {S : Type*} [Ring S] {T : Type*} [Ring T]

lemma mapMatrixUnits_elementary (f : R →+* S) (i j : n) (hij : i ≠ j) (a : R) :
    Units.map (RingHom.mapMatrix f).toMonoidHom (elementary i j hij a) =
      elementary i j hij (f a) := by
  apply Units.ext
  change (RingHom.mapMatrix f) (1 + Matrix.single i j a) =
    1 + Matrix.single i j (f a)
  rw [map_add, map_one]
  congr 1
  exact Matrix.map_single i j a f

/-- Change of rings preserves the subgroup generated by elementary matrices. -/
lemma map_elementarySubgroup_le (f : R →+* S) :
    (elementarySubgroup n R).map (Units.map (RingHom.mapMatrix f).toMonoidHom) ≤
      elementarySubgroup n S := by
  rw [Subgroup.map_le_iff_le_comap]
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨i, j, hij, a, rfl⟩
  change Units.map (RingHom.mapMatrix f).toMonoidHom (elementary i j hij a) ∈ elementarySubgroup n S
  rw [mapMatrixUnits_elementary]
  exact elementary_mem_subgroup i j hij (f a)

end RingMap

end Matrix.GeneralLinearGroup
